# Globe Detective needs NO environment variables to build or run.
# Everything below is optional and is read at BUILD time (Vite embeds VITE_* values in the bundle).
# Do not put secrets here: anything prefixed VITE_ is public.

# Earth surface imagery for the 3D globe. Defaults to the copies shipped in public/img.
# VITE_EARTH_TEXTURE_URL=/img/earth-blue-marble.jpg
# VITE_EARTH_BUMP_URL=/img/earth-topology.png

# Firebase Backend Configuration (Phase 13)
# These are public web client credentials (safe to commit or bundle).
# If omitted or empty, the app gracefully operates in local Guest Mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudflare Worker API URL (Free Tier Backend Alternative to Firebase Blaze)
# If set, challenge scoring & leaderboard updates are verified on Cloudflare Workers without requiring Blaze.
# Example: https://globe-detective-api.your-account.workers.dev
VITE_WORKER_API_URL=
